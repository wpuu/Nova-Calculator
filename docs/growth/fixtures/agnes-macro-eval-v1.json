      "old_dom": "<button id='export-btn' aria-label='Export orders'>Export</button>",
      "new_dom": "<button id='download-orders' data-action='export' aria-label='Export orders'>Export</button>",
      "failure": "selector #export-btn not found",
      "expected_decision": "PATCH"
    },
    {
      "id": "repair-menu-move",
      "group": "repair",
      "goal": "Repair export action moved into a More menu",
      "old_step": {"id":"s4","op":"CLICK","selector":"button[data-action='export']"},
      "old_dom": "<button data-action='export'>Export</button>",
      "new_dom": "<button aria-label='More actions' data-action='more'>More</button><div role='menu' hidden><button role='menuitem' data-action='export'>Export</button></div>",
      "failure": "target exists but is not visible",
      "expected_decision": "PATCH",
      "requirements": ["minimal patch may insert menu-open step before export"]
    },
    {
