  "cases": [
    {
      "id": "opt-fixed-waits",
      "group": "optimize",
      "goal": "Export orders after selecting date range",
      "raw_trace": [
        {"op":"CLICK","selector":"#orders-tab"},
        {"op":"SLEEP","ms":3000},
        {"op":"CLICK","selector":".date-input-8f91"},
        {"op":"TYPE","selector":".date-input-8f91","text":"2026-08-01"},
        {"op":"SLEEP","ms":5000},
        {"op":"CLICK","selector":"#export-btn"}
      ],
      "dom_context": "<button id='orders-tab'>Orders</button><label for='fromDate'>From</label><input id='fromDate' name='fromDate'><button id='export-btn' disabled aria-label='Export orders'>Export</button>",
      "requirements": ["replace fixed sleeps with state waits", "parameterize date", "preserve export intent"],
      "forbidden": ["SLEEP", "invented selector"]
    },
    {
      "id": "opt-loop-skus",
      "group": "optimize",
      "goal": "Look up a list of SKUs one by one",
