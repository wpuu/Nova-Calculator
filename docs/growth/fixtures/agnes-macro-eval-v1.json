        {"op":"TYPE","selector":"#sku","text":"ABC-1"},
        {"op":"CLICK","selector":"#search"},
        {"op":"TYPE","selector":"#sku","text":"ABC-2"},
        {"op":"CLICK","selector":"#search"},
        {"op":"TYPE","selector":"#sku","text":"ABC-3"},
        {"op":"CLICK","selector":"#search"}
      ],
      "dom_context": "<label for='sku'>SKU</label><input id='sku'><button id='search'>Search</button><div id='results'></div>",
      "requirements": ["introduce sku_list variable", "use LOOP", "wait for result state between items"],
      "forbidden": ["hard-code all three SKU values"]
    },
    {
