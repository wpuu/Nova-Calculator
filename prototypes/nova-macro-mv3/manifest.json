{
  "manifest_version": 3,
  "name": "Nova Macro Semantic POC",
  "version": "0.0.3",
  "description": "Local-first semantic browser macro proof of concept.",
  "permissions": ["activeTab", "identity", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nova Macro POC",
    "default_popup": "popup.html"
  }
}
